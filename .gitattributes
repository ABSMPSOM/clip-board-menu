# Step 1: Tell GitHub to ignore everything (treat as vendored/documentation)
* linguist-vendored
* linguist-documentation

# Step 2: Create a strict exception ONLY for Python files
*.py linguist-vendored=false
*.py linguist-detectable=true
*.py linguist-documentation=false

# Step 3: Explicitly kill the TeX and HTML detection
*.tex linguist-detectable=false
*.md linguist-detectable=false
*.html linguist-detectable=false